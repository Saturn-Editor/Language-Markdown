      "patterns": [{ "begin": "(^|\\G)(\\s*)(.*)", "while": "(^|\\G)(?![ \\t]*([`~]{3,})[ \\t]*$)", "contentName": "meta.embedded.block.javascript", "patterns": [{ "include": "source.js" }] }]
    },
    "fenced-ts": {
