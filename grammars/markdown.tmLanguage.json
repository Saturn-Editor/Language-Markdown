{
  "name": "Markdown",
  "scopeName": "text.html.markdown",
  "fileTypes": ["md", "markdown"],
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#block" }
  ],
  "repository": {
    "block": {
      "patterns": [
        { "include": "#fenced-code" },
        { "include": "#html-comment" },
        { "include": "#heading" },
        { "include": "#blockquote" },
        { "include": "#hr" },
        { "include": "#setext-underline" },
        { "include": "#reference-definition" },
        { "include": "#table" },
        { "include": "#list-marker" },
        { "include": "#inline" }
      ]
    },

    "frontmatter": {
      "begin": "\\A(-{3})[ \\t]*$",
      "beginCaptures": { "1": { "name": "punctuation.definition.frontmatter.markdown" } },
      "end": "(^|\\G)(-{3}|\\.{3})[ \\t]*$",
      "endCaptures": { "2": { "name": "punctuation.definition.frontmatter.markdown" } },
      "contentName": "meta.embedded.block.frontmatter",
      "patterns": [{ "include": "source.yaml" }]
    },

    "heading": {
      "match": "(?:^|\\G)[ \\t]{0,3}(#{1,6})(?:[ \\t]+(.*?))?(?:[ \\t]+#+)?[ \\t]*$",
      "name": "markup.heading.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.heading.markdown" },
        "2": { "name": "entity.name.section.markdown" }
      }
    },

    "setext-underline": {
      "match": "(?:^|\\G)[ \\t]{0,3}(=+|-+)[ \\t]*$",
      "name": "markup.heading.setext.markdown"
    },

    "hr": {
      "match": "(?:^|\\G)[ \\t]{0,3}([-*_])(?:[ \\t]*\\1){2,}[ \\t]*$",
      "name": "meta.separator.markdown"
    },

    "blockquote": {
      "begin": "(^|\\G)[ \\t]{0,3}(>) ?",
      "beginCaptures": { "2": { "name": "punctuation.definition.quote.begin.markdown" } },
      "while": "(^|\\G)[ \\t]{0,3}(>) ?",
      "whileCaptures": { "2": { "name": "punctuation.definition.quote.begin.markdown" } },
      "name": "markup.quote.markdown",
      "patterns": [{ "include": "#block" }]
    },

    "list-marker": {
      "match": "(?:^|\\G)[ \\t]*([-*+]|\\d{1,9}[.)])(?=[ \\t]|$)(?:[ \\t]+(\\[[ xX]\\])(?=[ \\t]))?",
      "captures": {
        "1": { "name": "punctuation.definition.list.begin.markdown" },
        "2": { "name": "markup.checkbox.markdown" }
      }
    },

    "reference-definition": {
      "match": "(?:^|\\G)[ \\t]{0,3}(\\[)([^\\]]+)(\\])(:)[ \\t]*(<[^>]*>|\\S+)(?:[ \\t]+(\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?[ \\t]*$",
      "name": "meta.link.reference.def.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.constant.begin.markdown" },
        "2": { "name": "constant.other.reference.link.markdown" },
        "3": { "name": "punctuation.definition.constant.end.markdown" },
        "4": { "name": "punctuation.separator.key-value.markdown" },
        "5": { "name": "markup.underline.link.markdown" },
        "6": { "name": "string.other.link.title.markdown" }
      }
    },

    "table": {
      "begin": "(?:^|\\G)(?=[ \\t]*\\|)",
      "end": "$",
      "name": "markup.table.markdown",
      "patterns": [
        { "match": "\\|", "name": "punctuation.separator.table.markdown" },
        { "match": "(?<=\\|)[ \\t]*:?-+:?[ \\t]*(?=\\||$)", "name": "punctuation.separator.table.markdown" },
        { "include": "#inline" }
      ]
    },

    "html-comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html.markdown"
    },

    "fenced-code": {
      "patterns": [
        { "include": "#fenced-js" },
        { "include": "#fenced-ts" },
        { "include": "#fenced-json" },
        { "include": "#fenced-css" },
        { "include": "#fenced-scss" },
        { "include": "#fenced-less" },
        { "include": "#fenced-html" },
        { "include": "#fenced-xml" },
        { "include": "#fenced-php" },
        { "include": "#fenced-python" },
        { "include": "#fenced-shell" },
        { "include": "#fenced-powershell" },
        { "include": "#fenced-csharp" },
        { "include": "#fenced-c" },
        { "include": "#fenced-cpp" },
        { "include": "#fenced-java" },
        { "include": "#fenced-kotlin" },
        { "include": "#fenced-go" },
        { "include": "#fenced-rust" },
        { "include": "#fenced-ruby" },
        { "include": "#fenced-swift" },
        { "include": "#fenced-lua" },
        { "include": "#fenced-sql" },
        { "include": "#fenced-yaml" },
        { "include": "#fenced-toml" },
        { "include": "#fenced-ini" },
        { "include": "#fenced-diff" },
        { "include": "#fenced-dockerfile" },
        { "include": "#fenced-markdown" },
        { "include": "#fenced-plain" }
      ]
    },

    "fenced-plain": {
      "begin": "(^|\\G)([ \\t]*)(`{3,}|~{3,})[ \\t]*([^`\\s]*)[^`]*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)[ \\t]*(\\3[`~]*)[ \\t]*$",
      "endCaptures": { "2": { "name": "punctuation.definition.markdown" } },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "markup.raw.block.markdown"
    },

    "fenced-js": {
      "begin": "(^|\\G)([ \\t]*)(`{3,}|~{3,})[ \\t]*((?i:js|javascript|jsx|mjs|cjs|node))(?=[\\s{]|$)[^`]*$",
