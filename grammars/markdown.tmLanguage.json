    "inline": {
      "patterns": [
        { "include": "#escape" },
        { "include": "#code-span" },
        { "include": "#image" },
        { "include": "#link-inline" },
        { "include": "#link-reference" },
        { "include": "#autolink" },
        { "include": "#html-comment" },
        { "include": "#html-tag" },
        { "include": "#bold" },
        { "include": "#italic" },
        { "include": "#strikethrough" },
        { "include": "#bare-url" }
      ]
    },

    "escape": {
      "match": "\\\\[!-/:-@\\[-`{-~]",
      "name": "constant.character.escape.markdown"
    },

    "code-span": {
      "match": "(`+)(?!`)(.+?)(?<!`)(\\1)(?!`)",
      "name": "markup.inline.raw.markdown"
    },

    "image": {
      "match": "(!\\[)((?:[^\\[\\]\\\\]|\\\\.)*)(\\])(\\()[ \\t]*(<[^>]*>|[^\\s)]+)(?:[ \\t]+(\"[^\"]*\"|'[^']*'))?[ \\t]*(\\))",
      "name": "meta.image.inline.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.link.description.begin.markdown" },
        "2": { "name": "string.other.link.description.markdown" },
        "3": { "name": "punctuation.definition.link.description.end.markdown" },
        "4": { "name": "punctuation.definition.metadata.markdown" },
        "5": { "name": "markup.underline.link.image.markdown" },
        "6": { "name": "string.other.link.title.markdown" },
        "7": { "name": "punctuation.definition.metadata.markdown" }
      }
    },

    "link-inline": {
      "match": "(\\[)((?:[^\\[\\]\\\\]|\\\\.|\\[[^\\]]*\\])*)(\\])(\\()[ \\t]*(<[^>]*>|(?:[^\\s()]|\\([^\\s()]*\\))+)?(?:[ \\t]+(\"[^\"]*\"|'[^']*'))?[ \\t]*(\\))",
      "name": "meta.link.inline.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.link.title.begin.markdown" },
        "2": { "name": "string.other.link.title.markdown" },
        "3": { "name": "punctuation.definition.link.title.end.markdown" },
        "4": { "name": "punctuation.definition.metadata.markdown" },
        "5": { "name": "markup.underline.link.markdown" },
        "6": { "name": "string.other.link.title.markdown" },
        "7": { "name": "punctuation.definition.metadata.markdown" }
      }
    },

    "link-reference": {
      "match": "(\\[)((?:[^\\[\\]\\\\]|\\\\.)+)(\\])(\\[)([^\\]]*)(\\])",
      "name": "meta.link.reference.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.link.title.begin.markdown" },
        "2": { "name": "string.other.link.title.markdown" },
        "3": { "name": "punctuation.definition.link.title.end.markdown" },
        "4": { "name": "punctuation.definition.constant.begin.markdown" },
        "5": { "name": "constant.other.reference.link.markdown" },
        "6": { "name": "punctuation.definition.constant.end.markdown" }
      }
    },

    "autolink": {
      "match": "(<)((?:https?|ftp|mailto):[^\\s>]+|[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.link.markdown" },
        "2": { "name": "markup.underline.link.markdown" },
        "3": { "name": "punctuation.definition.link.markdown" }
      }
    },

    "bare-url": {
      "match": "(?<![\\w/])(?:https?://|www\\.)[^\\s<>()\\[\\]]*[^\\s<>()\\[\\].,:;\"'!?]",
      "name": "markup.underline.link.markdown"
    },

    "html-tag": {
      "match": "</?[A-Za-z][\\w-]*(?:\\s+[^<>]*?)?/?>",
      "name": "meta.tag.inline.html.markdown"
    },

    "bold": {
      "patterns": [
        { "match": "(\\*\\*)(?=\\S)(.+?)(?<=\\S)(\\*\\*)", "name": "markup.bold.markdown" },
        { "match": "(?<!\\w)(__)(?=\\S)(.+?)(?<=\\S)(__)(?!\\w)", "name": "markup.bold.markdown" }
      ]
    },

    "italic": {
      "patterns": [
        { "match": "(?<![\\w*])(\\*)(?=[^\\s*])(.+?)(?<=[^\\s*])(\\*)(?!\\*)", "name": "markup.italic.markdown" },
        { "match": "(?<![\\w_])(_)(?=[^\\s_])(.+?)(?<=[^\\s_])(_)(?![\\w_])", "name": "markup.italic.markdown" }
      ]
    },

    "strikethrough": {
      "match": "(~~)(?=\\S)(.+?)(?<=\\S)(~~)",
      "name": "markup.strikethrough.markdown"
    }
  }
}
