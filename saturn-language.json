{
  "id": "markdown",
  "name": "Markdown",
  "version": "1.3.1",
  "description": "Language module for Markdown files (.md)",
  "saturnApi": "^1.0",
  "main": "module.js",
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "name": "Markdown",
        "extensions": [".md", ".markdown"],
        "grammar": "grammars/markdown.tmLanguage.json"
      }
    ],
    "languageServer": {
      "command": "node",
      "args": ["server/server.js", "--stdio"],
      "features": ["completion", "diagnostics", "symbols", "formatting", "rename"]
    },
    "previews": [{ "id": "markdown.preview", "label": "Markdown", "extensions": [".md", ".markdown"], "defaultView": "split" }],
    "fileTemplates": [
      { "id": "markdown.readme", "label": "Markdown File", "kind": "file", "extension": ".md", "placeholder": "Title" }
    ],
    "settings": [
      {
        "id": "remoteImages",
        "label": "Load remote images in preview",
        "type": "checkbox",
        "default": true,
        "description": "Show images from web addresses in the preview."
      }
    ],
    "commands": [{ "id": "markdown.openReadme", "title": "Open README" }],
    "newProject": {
      "language": "markdown",
      "fields": [
        { "id": "title", "label": "Title", "type": "text", "default": "My Notes" },
        { "id": "readme", "label": "Create README.md", "type": "checkbox", "default": true }
      ]
    }
  }
}
